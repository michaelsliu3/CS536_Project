# One-command wrappers for the dataset scripts (the dataset itself stays ignored)
!data/build_dataset.sh
!data/clean_dataset.sh
# A small committed sample of the dataset (2 PRs); the full build in data/aacr stays ignored
!data/aacr_sample/

models/*
!models/.gitkeep

checkpoints/*
!checkpoints/.gitkeep

*.safetensors
*.bin
*.pt
*.pth

# Lavish local artifacts
.lavish/
docs/1st_meeting_transcript/
docs/professor_meeting_transcript/

# Working notes, scripts and caches behind the research reports; kept locally
research_notes/

# Research reports written by deep-research runs; kept locally
reports/

# Model output caches of the selector notebooks (tens of MB of .npy; kept on Drive)
results/*/cache/
# The same for quick trial runs (selector_gate_llm.py --limit)
results/*/cache_check/
